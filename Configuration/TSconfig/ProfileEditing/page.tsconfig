# Page TSconfig of the profile editing content element.
#
# Delivered by the set "fgtclb/academic-persons-edit-profile-editing" and
# registered for the page field "Page TSconfig" by
# "Configuration/TCA/Overrides/pages.php" - one physical copy, two ways to it.
#
# The content element is hidden for the whole installation by
# "Configuration/page.tsconfig"; this file is what makes it selectable again,
# so it applies where the component is actually wanted instead of everywhere.
TCEFORM.tt_content.CType.removeItems := removeFromList(academicpersonsedit_profileediting)

mod.wizards.newContentElement.wizardItems.academic {
  elements {
    academicpersonsedit_profileediting {
      iconIdentifier = persons_edit_icon
      title = LLL:EXT:academic_persons_edit/Resources/Private/Language/locallang_be.xlf:newContentElement.wizardItems.academic.profileEditing.title
      description = LLL:EXT:academic_persons_edit/Resources/Private/Language/locallang_be.xlf:newContentElement.wizardItems.academic.profileEditing.description
      tt_content_defValues {
        CType = academicpersonsedit_profileediting
      }
    }
  }
}
