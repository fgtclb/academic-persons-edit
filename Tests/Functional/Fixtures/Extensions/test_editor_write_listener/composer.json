{
    "name": "tests/test-editor-write-listener",
    "description": "Extension with a configurable listener of the profile editing write event of academic_persons_edit",
    "type": "typo3-cms-extension",
    "license": "GPL-2.0-or-later",
    "authors": [
        {
            "name": "Stefan Bürk",
            "email": "stefan@buerk.tech",
            "role": "Maintainer"
        }
    ],
    "require": {
        "typo3/cms-core": "~13.4.35 || ~14.3.7",
        "fgtclb/academic-persons-edit": "~3.0.0@dev"
    },
    "extra": {
        "typo3/cms": {
            "extension-key": "test_editor_write_listener",
            "version": "3.0.0-dev",
            "Package": {
                "providesPackages": []
            }
        }
    },
    "autoload": {
        "psr-4": {
            "TESTS\\TestEditorWriteListener\\": "Classes/"
        }
    }
}
